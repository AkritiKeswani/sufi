# Copy this file to .env.local and add your keys:
#   cp .env.local.example .env.local

# Required for "Reveal meaning" — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for "Compose a new shayari" — https://aistudio.google.com/apikey
# Gemini generates a fresh Urdu shayari (script + transliteration + meaning).
GEMINI_API_KEY=

# Optional, for audio recitation — https://elevenlabs.io/app/settings/api-keys
# Without it, the play button shows a friendly "not connected" message.
ELEVENLABS_API_KEY=

# Optional recitation voice. Defaults to the premade "Daniel" (works on Free).
# Voice Library voices (e.g. an Urdu voice) require a PAID plan + "Add to My
# Voices" first, or the API returns 402. Once on a paid plan:
# ELEVENLABS_VOICE_ID=

# Required for authentication — https://dashboard.clerk.com (API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
