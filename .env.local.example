# Copy this file to .env.local and add your keys:
#   cp .env.local.example .env.local

# Required for "Reveal meaning" — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for "Compose a new shayari" — https://aistudio.google.com/apikey
# Gemini generates a fresh Urdu shayari (script + transliteration + meaning).
GEMINI_API_KEY=
# Optional: pin a Gemini model. Otherwise the newest available "flash" is used.
# GEMINI_MODEL=gemini-3.8-flash

# Recitation in your own voice — design or replicate a voice in Google AI
# Studio, then put its name (as "Get code" shows it, e.g. akriti-voice) here. It must be made in the same
# Google project as GEMINI_API_KEY. When set, it recites everything.
GEMINI_TTS_VOICE_ID=
# Optional: a second voice to use if the first one is rejected.
GEMINI_TTS_FALLBACK_VOICE_ID=
# Optional: GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional, for audio recitation — https://elevenlabs.io/app/settings/api-keys
# Without it, the play button shows a friendly "not connected" message.
ELEVENLABS_API_KEY=

# Optional recitation voice. Defaults to the premade "Daniel" (works on Free).
# Voice Library voices (e.g. an Urdu voice) require a PAID plan + "Add to My
# Voices" first, or the API returns 402. Once on a paid plan:
# ELEVENLABS_VOICE_ID=

# Required for authentication — https://dashboard.clerk.com (API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Saving (favorites, the bank, the writing playground) — Supabase project
# URL and publishable key. Clerk must be added as a third-party auth provider
# in Supabase, and supabase/schema.sql run once.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
